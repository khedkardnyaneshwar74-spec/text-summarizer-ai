# Environment Configuration for TextSummarize AI

# Default model key: 'distilbart', 'bart-large', or 't5-small'
DEFAULT_MODEL=distilbart

# Hugging Face cache directory (optional)
# HF_HOME=./.cache/huggingface

# Device configuration: 'cpu', 'cuda', or 'auto'
DEVICE=auto

# Maximum input characters allowed in web UI
MAX_INPUT_CHARS=100000

# Streamlit port and server settings
PORT=8501
